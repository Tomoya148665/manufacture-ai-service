# Vite 用 .env サンプル
# このファイルを .env または .env.local にコピーして値を設定してください。
# 注意: ブラウザで参照するには変数名は VITE_ で始まる必要があります。

# 必須: OpenAI API キー（フロントエンドで使用）
# 例: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_OPENAI_API_KEY=

# Netlify Functions 用（サーバ側）
# OpenAI API キー（Functions が STT/TTS に使用）
OPENAI_API_KEY=

# セキュリティ注意: 現状ブラウザから OpenAI を直接呼び出します
# (dangerouslyAllowBrowser=true)。本番ではサーバ経由のプロキシを推奨します。
